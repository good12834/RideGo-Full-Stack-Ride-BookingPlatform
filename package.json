{
  "name": "ridego",
  "version": "1.0.0",
  "private": true,
  "description": "RideGo — full-stack ride booking platform",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:memory --prefix backend\" \"npm run dev --prefix frontend\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
