# ===================================================
# RideGo Backend Environment Configuration Template
# Copy this file to .env and adjust your variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/ridego

# Authentication & Security
JWT_SECRET=ridego_local_dev_secret_2026
JWT_EXPIRES_IN=7d

# Pricing & Commission Settings
COMMISSION_RATE=0.1
FARE_CURRENCY_SYMBOL=$
FARE_CURRENCY_CODE=USD
SURGE_MIN=1.0
SURGE_MAX=2.5

# Stripe Payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Intelligence & Neural Engine (Google Gemini API — https://aistudio.google.com/apikey)
# GEMINI_API_KEY upgrades the built-in Neural NLP engine to the Gemini foundation model.
# Leave blank to keep the offline built-in engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
OPENAI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Cloudinary Media Storage (Optional: https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
