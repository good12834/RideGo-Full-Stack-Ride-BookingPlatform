# RideGo Frontend Environment Variables Example
# Copy this file to .env to configure local frontend settings

# Base API URL for backend endpoints
VITE_API_URL=http://localhost:5000/api

# WebSocket Server URL for live ride tracking and real-time events
VITE_SOCKET_URL=http://localhost:5000

# Stripe Publishable Key for card elements & checkout
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Application Name
VITE_APP_NAME=RideGo AI Mobility

# Feature flags
VITE_ENABLE_AI_COPILOT=true
